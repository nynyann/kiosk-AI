# Chép thành .env rồi sửa. KHÔNG đẩy .env lên git.

# Chạy máy chủ giả cho Kns
MOCK=0

# Mô hình. Nhớ chuyển sang CTranslate2 trước, xem scripts/convert_phowhisper.sh
ASR_MODEL=models/PhoWhisper-small-ct2
ASR_MODEL_LABEL=PhoWhisper-small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_EAGER_LOAD=0

# Đọc thành tiếng. Giọng: vi-VN-HoaiMyNeural (nữ) hoặc vi-VN-NamMinhNeural (nam).
# CẦN MẠNG lúc chạy. Tắt bằng TTS_ENABLED=0, giao diện sẽ dùng giọng trình duyệt.
TTS_ENABLED=1
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=-8%

# Giao diện và API cùng tên miền nên không vướng CORS. Chỉ điền khi có trang
# khác ở tên miền khác gọi vào API này.
ALLOWED_ORIGINS=*

KB_MATCH_THRESHOLD=0.55
ASR_CONFIDENCE_FLOOR=0.45

# Mô hình ngôn ngữ trên FPT AI Marketplace (marketplace.fptcloud.com).
# Để trống là TẮT: kiosk chạy bằng kho tri thức tĩnh. Có khoá thì máy hiểu
# hoàn cảnh bác kể, nhận ra thủ tục khi từ khoá không bắt được, hiểu câu trả
# lời tự do, và trả lời câu hỏi thêm bằng lời tự nhiên nhưng chỉ từ kho.
# Tạo khoá ở My account / My API Keys; tài khoản phải có số dư > 0.
FPT_API_KEY=
FPT_BASE_URL=https://mkp-api.fptcloud.com
LLM_MODEL=Saola-Small-32B
LLM_TIMEOUT_SECONDS=12
